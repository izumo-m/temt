#!/bin/bash
# インスタンスのタイムゾーンを Asia/Tokyo にする。deploy が root で実行する。何度実行してもよい
set -euo pipefail

timedatectl set-timezone Asia/Tokyo
# 起動したときのタイムゾーンを使い続けるので、動いていれば起動し直す
for unit in cron.service rsyslog.service; do
    if systemctl is-active --quiet "$unit"; then
        systemctl restart "$unit"
    fi
done

echo "timezone-tokyo: $(timedatectl show --property=Timezone --value), now $(date '+%Y-%m-%d %H:%M:%S %Z')"
